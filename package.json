{
  "name": "saradiya-sutro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "cross-env VITE_USE_MOCK=false concurrently \"vite --host 127.0.0.1\" \"python -m uvicorn backend.main:app --reload --port 8000\"",
    "build": "tsc -b && vite build",
    "build:vercel": "cross-env VITE_USE_MOCK=false VITE_API_BASE_URL=/api npm run build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
