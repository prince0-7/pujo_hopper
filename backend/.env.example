# Copy to backend/.env and provide your own key.
TOMTOM_API_KEY=your_tomtom_api_key

# Optional override for the driving route geometry service.
# OSRM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving

# Optional override for the OSRM driving distance/duration matrix service.
# OSRM_TABLE_URL=https://router.project-osrm.org/table/v1/driving

# Optional override for walking, cycling, and motorcycle routing profiles.
# VALHALLA_URL=https://valhalla1.openstreetmap.de
